+package de.ggbot.core.nametag;
+
+import com.google.gson.Gson;
+import com.google.gson.reflect.TypeToken;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import net.labymod.api.util.io.web.request.Request;
+import net.labymod.api.util.io.web.request.Request.Method;
+
+public class GGBotTeamChecker {
+
+  private static final String TEAM_URL = "https://msapi.ggbot.de/team";
+
+  // Map<RoleName, List<UUIDs>>
+  private static final Map<String, List<String>> teamUUIDs = new HashMap<>();
+
+  public static void collectTeamUUIDs() {
+    Request.ofString()
+        .url(TEAM_URL)
+        .method(Method.GET)
+        .async()
+        .execute(response -> {
+          if (response.isPresent()) {
+            try {
+              String json = response.get();
+              Map<String, Object> root = new Gson().fromJson(json, new TypeToken<Map<String,Object>>(){}.getType());
+              List<Map<String, Object>> team = (List<Map<String, Object>>) root.get("team");
+
+              for (Map<String, Object> category : team) {
+                String roleName = (String) category.get("name");
+                List<Map<String, Object>> members = (List<Map<String, Object>>) category.get("members");
+                if (members == null) continue;
+
+                List<String> uuidsForRole = new ArrayList<>();
+                for (Map<String, Object> member : members) {
+                  Map<String, Object> minecraft = (Map<String, Object>) member.get("minecraft");
+                  if (minecraft != null && minecraft.get("uuid") != null) {
+                    uuidsForRole.add((String) minecraft.get("uuid"));
+                  }
+                }
+
+                if (!uuidsForRole.isEmpty()) {
+                  teamUUIDs.put(roleName, uuidsForRole);
+                }
+              }
+
+            } catch (Exception e) {
+              e.printStackTrace();
+            }
+          }
+        });
+  }
+
+  public static Map<String, List<String>> getTeamUUIDs() {
+    return teamUUIDs;
+  }
+  public static boolean isUuidInTeam(String uuid) {
+    if (uuid == null) return false;
+    String cleanUuid = uuid.replace("-", ""); // falls die UUID mit Bindestrichen kommt
+    for (List<String> uuids : teamUUIDs.values()) {
+      if (uuids.contains(cleanUuid)) {
+        return true;
+      }
+    }
+    return false;
+  }
+  public static String getRoleByUUID(String uuid) {
+    for (Map.Entry<String, List<String>> entry : teamUUIDs.entrySet()) {
+      if (entry.getValue().contains(uuid)) {
+        return entry.getKey();
+      }
+    }
+    return null; // null, wenn die UUID keiner Rolle zugeordnet ist
+  }
+}
