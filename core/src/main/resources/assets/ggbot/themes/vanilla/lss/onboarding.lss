.onboarding-panel {
  left: 50%;
  top: 50%;
  alignment-x: center;
  alignment-y: center;
  width: 60%;
  max-width: 360;
  min-width: 280;
  height: fit-content;
  max-height: 80%;
  background-color: #0a0e15;
  border-radius: 10;
  padding: 14;
  space-between-entries: 6;
}

.onboarding-header {
  width: 100%;
  font-size: 1.1;
  text-color: #3895ff;
  alignment-x: center;
  left: 50%;
  margin-bottom: 2;
}

.onboarding-step-title {
  width: 100%;
  font-size: 0.9;
  text-color: #f2f1e9;
  margin-top: 2;
}

.onboarding-line {
  width: 100%;
  font-size: 0.7;
  text-color: #c8d2de;
}

.onboarding-path-btn {
  width: 100%;
  height: 22;
  background-color: #1a2230;
  text-color: #f2f1e9;
  border-radius: 4;
  font-size: 0.8;
  margin-top: 3;
}

.onboarding-path-btn:hover { background-color: #25304a; }

.onboarding-keybind-row {
  width: 100%;
  height: 16;
  space-between-entries: 4;
  margin-bottom: 2;
  layout: spread;
}

.onboarding-keybind {
  height: 16;
  width:  80%;
  background-color: #1a2230;
  border-radius: 3;
}

.onboarding-keybind-reset {
  width: 70;
  height: 16;
  background-color: #2a3140;
  text-color: #cfe0ff;
  border-radius: 3;
  font-size: 0.6;
  right: 0;
  max-width: 70;
}

.onboarding-keybind-reset:hover { background-color: #35496e; }

.onboarding-buttons {
  width: 100%;
  height: 18;
  space-between-entries: 5;
  layout: fill;
  margin-top: 10;
}

.onboarding-btn {
  height: 18;
  background-color: #1a2230;
  text-color: #f2f1e9;
  border-radius: 4;
  font-size: 0.65;
}

.onboarding-btn:hover { background-color: #25304a; }

.onboarding-btn-primary {
  height: 18;
  background-color: #2a7d3f;
  text-color: #f2f1e9;
  border-radius: 4;
  font-size: 0.65;
}

.onboarding-btn-primary:hover { background-color: #36a34f; }

.onboarding-btn-cancel {
  height: 18;
  background-color: #2a3140;
  text-color: #ff9b9b;
  border-radius: 4;
  font-size: 0.65;
}

.onboarding-btn-cancel:hover { background-color: #3a2330; }
