.onboarding-panel {
  left: 50%;
  top: 50%;
  alignment-x: center;
  alignment-y: center;
  width: 330;
  height: 80%;
  max-height: 300;
  background-color: #0a0e15;
  border-radius: 10;
  padding: 14;
}

.onboarding-header {
  width: 100%;
  top: 0;
  left: 50%;
  font-size: 1.1;
  text-color: #3895ff;
  alignment-x: center;
}

/* Scrollable middle: sits below the header and above the pinned button bar,
   so a step taller than the box scrolls instead of overflowing. */
.onboarding-scroll {
  width: 100%;
  left: 0;
  top: 22;
  height: calc(100% - 48);
}

.onboarding-content {
  width: calc(100% - 6);
  height: fit-content;
  space-between-entries: 6;
  padding-right: 4;
}

.onboarding-step-title {
  width: 100%;
  font-size: 0.9;
  text-color: #f2f1e9;
  margin-top: 2;
}

.onboarding-line {
  width: 100%;
  font-size: 0.7;
  text-color: #c8d2de;
}

.onboarding-path-btn {
  width: 100%;
  height: 22;
  background-color: #1a2230;
  text-color: #f2f1e9;
  border-radius: 4;
  font-size: 0.8;
  margin-top: 3;
}

.onboarding-path-btn:hover { background-color: #25304a; }

.onboarding-toggle-on {
  width: 100%;
  height: 16;
  background-color: #1d3a26;
  text-color: #9fe0ae;
  border-radius: 4;
  font-size: 0.65;
  margin-top: 2;
}

.onboarding-toggle-on:hover { background-color: #26502f; }

.onboarding-toggle-off {
  width: 100%;
  height: 16;
  background-color: #3a2323;
  text-color: #e0a1a1;
  border-radius: 4;
  font-size: 0.65;
  margin-top: 2;
}

.onboarding-toggle-off:hover { background-color: #502c2c; }

.onboarding-keybind-row {
  width: 100%;
  height: 16;
  space-between-entries: 4;
  margin-bottom: 2;
  layout: spread;
}

.onboarding-keybind {
  height: 16;
  width:  80%;
  background-color: #1a2230;
  border-radius: 3;
}

.onboarding-keybind-reset {
  width: 70;
  height: 16;
  background-color: #2a3140;
  text-color: #cfe0ff;
  border-radius: 3;
  font-size: 0.6;
  right: 0;
  max-width: 70;
}

.onboarding-keybind-reset:hover { background-color: #35496e; }

.onboarding-buttons {
  width: 100%;
  height: 18;
  bottom: 0;
  left: 0;
  space-between-entries: 5;
  layout: fill;
}

.onboarding-botselect-row {
  width: 100%;
  height: 16;
  space-between-entries: 4;
  margin-bottom: 2;
  layout: spread;
}

.onboarding-botselect {
  height: 16;
  width: 78%;
  background-color: #1a2230;
  border-radius: 3;
}

.onboarding-botselect-refresh {
  width: 70;
  max-width: 70;
  height: 16;
  background-color: #2a3140;
  text-color: #cfe0ff;
  border-radius: 3;
  font-size: 0.6;
  right: 0;
}

.onboarding-botselect-refresh:hover { background-color: #35496e; }

.onboarding-btn {
  height: 18;
  background-color: #1a2230;
  text-color: #f2f1e9;
  border-radius: 4;
  font-size: 0.65;
}

.onboarding-btn:hover { background-color: #25304a; }

.onboarding-btn-primary {
  height: 18;
  background-color: #2a7d3f;
  text-color: #f2f1e9;
  border-radius: 4;
  font-size: 0.65;
}

.onboarding-btn-primary:hover { background-color: #36a34f; }

.onboarding-btn-cancel {
  height: 18;
  background-color: #2a3140;
  text-color: #ff9b9b;
  border-radius: 4;
  font-size: 0.65;
}

.onboarding-btn-cancel:hover { background-color: #3a2330; }
